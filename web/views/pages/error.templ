package pages

import (
	"strconv"
	"workshop/web/views/layout"
)

templ Error(message string, code int) {
	@layout.Base(layout.BaseProps{
		Title: strconv.Itoa(code) + " Error",
	}) {
		<section class="error-page">
			<p class="error-code">{ strconv.Itoa(code) }</p>
			<p class="error-message">{ message }</p>
		</section>
	}
}
